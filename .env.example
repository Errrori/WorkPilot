# 复制为 .env 后按需修改；.env 已被 git 忽略，进程环境变量优先于 .env。
# Go 端由 config.Load（godotenv）加载，sidecar 由 python-dotenv 加载，docker compose 也读取本文件做端口插值。
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
SIDECAR_URL=http://localhost:8000
FILE_STORAGE_DIR=./data/files
MAX_UPLOAD_MB=50
PARSER_TIMEOUT_SECONDS=120

# RAG 索引（Ollama + bge-m3，1024 维，需先 `ollama pull bge-m3`）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=120
CHUNK_SIZE=800
CHUNK_OVERLAP=100
INDEX_WORKERS=1

# RAG 问答（OpenAI 兼容接口；默认走本机 Ollama 的 OpenAI 兼容端点 /v1，需先 `ollama pull qwen2.5:7b`）
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1、LLM_MODEL=deepseek-chat、LLM_API_KEY=sk-xxx
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=6

# 任务抽取（从群内已索引资料抽取任务建议）
TASK_EXTRACT_MAX=20
TASK_EXTRACT_BUDGET=12000

# 风险识别（任务看板快照 + 群内已索引资料，共享字符预算）
RISK_EXTRACT_MAX=10
RISK_EXTRACT_BUDGET=12000

# 自定义 AI 任务与定时周报（asynq，复用 Redis；cron 按 AI_TASK_TIMEZONE 解释）
AI_TASK_WORKERS=1
AI_TASK_TIMEZONE=Asia/Shanghai
AI_TASK_BUDGET=12000

# compose 宿主机端口映射（与上面的 DATABASE_URL / REDIS_ADDR / SIDECAR_URL 端口保持一致）
POSTGRES_PORT=5432
REDIS_PORT=6379
SIDECAR_PORT=8000
